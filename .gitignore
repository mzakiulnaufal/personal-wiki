# OS and editor noise
.DS_Store
Thumbs.db
*.swp
*.swo

# Obsidian local state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspaces.json
.obsidian/cache
.obsidian/plugins/
.obsidian/trash/
.trash/

# Raw source material — only exclude sensitive private subdirectories. 
# Everything else (raw/sources/, raw/papers/, etc.) is tracked.
# raw/ itself is NOT ignored, so subfolders not listed here are tracked.
!raw/
raw/ACCA/**
raw/Clippings/**
raw/private/**

# Legacy clipper inbox. Use raw/inbox/ instead.
Clippings/

# Private working pages stay local.
private/**
!private/
!private/Goals/
!private/Goals/.gitkeep
!private/Goals/Priority 0.md
!private/Skills/
!private/Skills/.gitkeep

# Secrets and local config
.env
.env.*
*.key
*.pem

# Generated caches
.cache/
node_modules/
__pycache__/
*.pyc

# Quartz build output and caches
public/
.quartz-cache/
.aider*

# workbench/ directory is public; files inside are private working drafts
workbench/*
!workbench/.gitkeep
